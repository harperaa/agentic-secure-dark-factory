#!/usr/bin/env bash
# Fake `npm` for adapter contract tests: `npm ci` materialises node_modules and nothing else.
set -euo pipefail
printf 'npm %s\n' "$*" >> "${FAKE_LOG:-/dev/null}"
case "${1:-}" in
  ci) mkdir -p node_modules; touch node_modules/.fake ;;
  audit) if [ "${2:-}" = "fix" ]; then touch node_modules/.audit-fixed; exit 0; fi
         [ -f node_modules/.audit-fixed ] && exit 0
         [ "${FAKE_NPM_AUDIT_FAILS:-0}" = "1" ] && exit 1 || exit 0 ;;
  *) exit 0 ;;
esac
