#!/usr/bin/env bash
# Fake `detect-secrets` for contract tests: `scan` prints an empty baseline.
set -euo pipefail
printf 'detect-secrets %s\n' "$*" >> "${FAKE_LOG:-/dev/null}"
case "${1:-}" in
  scan) printf '{"version":"1.5.0","plugins_used":[],"filters_used":[],"results":{},"generated_at":"fake"}\n' ;;
  *) exit 0 ;;
esac
