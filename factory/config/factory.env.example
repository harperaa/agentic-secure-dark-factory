# Agentic Secure Dark Factory — operator environment.
# Copy to a private location (never into the repo), fill in, then `set -a; source factory.env; set +a`.
# Every factory script reads its inputs from here or from the spec; nothing is hard-coded.

# --- Paths --------------------------------------------------------------------------------
# Absolute path of this repository checkout.
FACTORY_ROOT=/absolute/path/to/agentic-secure-dark-factory
# Directory genesis clones new products into. Registered in worker.toml as `factory-workspace`.
FACTORY_WORKSPACE=/absolute/path/to/factory-workspace
# Root for git worktrees; must match the layout stated in the generated AGENTS.md and Machinist's foreman.
WORKTREE_ROOT=~/Code/.worktrees

# --- Machinist ----------------------------------------------------------------------------
# Where the rendered config.toml / worker.toml / prompts are installed.
MACHINIST_HOME=~/.machinist
# Control-plane URL the worker and submit-job.sh talk to (loopback by default).
MACHINIST_URL=http://127.0.0.1:7331
MACHINIST_LISTEN=127.0.0.1:7331
# Bearer token file shared by workers and API submitters.
MACHINIST_TOKEN_FILE=~/.machinist/server/worker.token
# Pinned Machinist release; upstream prompts (foreman, shepherd) are fetched at this ref.
MACHINIST_VERSION=v0.4.0
# Worker identity advertised to the control plane.
MACHINIST_WORKER_NAME=local-worker
MACHINIST_MAX_CONCURRENT_JOBS=1

# --- Upstream template --------------------------------------------------------------------
SVCOS_TEMPLATE_URL=https://github.com/harperaa/secure-vibe-coding-OS.git
# Branch or tag genesis clones. Pin to a release for reproducible products.
SVCOS_TEMPLATE_REF=main

# --- Provider accounts used by genesis (default profile) ----------------------------------
# Convex team slug (required when the account belongs to more than one team).
CONVEX_TEAM=
# Vercel team or user scope passed to `vercel link` / `vercel project add`.
VERCEL_SCOPE=
# Doppler service-account token with project-create scope (design R2). Read by the Doppler CLI.
DOPPLER_TOKEN=
# Branch protection mode applied to product repos: `team` requires one review, `solo` none.
# Dark-mode repos need `solo` (design §12.2 #1) unless a factory reviewer identity exists.
LOCKDOWN_MODE_DARK=solo
LOCKDOWN_MODE_GRAY=team
# Additional required status-check contexts added after lockdown-main.sh (comma-separated).
FACTORY_REQUIRED_CONTEXTS=semgrep,secrets,security-check

# --- Review gate --------------------------------------------------------------------------
# Login of the AI reviewer's GitHub App bot account.
GREPTILE_BOT_LOGIN=greptile-apps[bot]
# Intake label the foreman trigger watches for.
MACHINIST_REQUEST_LABEL=machinist:requested

# --- Sandbox execution (optional) ---------------------------------------------------------
# local | daytona | cloudflare | scaleway
SANDBOX_BACKEND=local
SANDBOX_SNAPSHOT=svcos-factory
